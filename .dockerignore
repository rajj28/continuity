# Keep the build context small and the image honest.
.git
.venv
__pycache__
*.pyc
.pytest_cache

# 224 MB of Sintel master. It lives in GCS; an image that carried it would be
# slow to deploy and would tempt someone into treating a baked-in copy as the
# source of truth.
assets/sintel
out
bin

# Never ship credentials in a layer.
.env.local
.env

# Not needed at runtime.
tests
docs
scripts
deploy
grafana/rules/tests
