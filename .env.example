# Copy to .env.local (gitignored) and fill in. NEVER commit the filled version.

# ---- Google Cloud -------------------------------------------------------
GCP_PROJECT_ID=
GCP_REGION=us-central1
GCS_BUCKET=                      # content-addressed asset store

# ---- Grafana Cloud ------------------------------------------------------
# Stack URL is not a secret; the tokens are.
GRAFANA_URL=https://<stack>.grafana.net
GRAFANA_SERVICE_ACCOUNT_TOKEN=   # Viewer role  -> mcp-investigator
GRAFANA_SCRIBE_TOKEN=            # narrow write -> mcp-scribe

# Traces MCP (first-party Tempo) uses HTTP Basic: <user-id>:<token>
GRAFANA_TEMPO_MCP_URL=https://<stack>.grafana.net/tempo/api/mcp
GRAFANA_TEMPO_USER_ID=
GRAFANA_TEMPO_TOKEN=

# OTLP ingest (from the Grafana Cloud "OpenTelemetry" connection page)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=      # Authorization=Basic <base64 user:token>

# Prometheus remote-write (from the Grafana Cloud Prometheus datasource page)
PROM_REMOTE_WRITE_URL=
PROM_USER_ID=
PROM_TOKEN=
